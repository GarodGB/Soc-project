# ─────────────────────────────────────────────────────────────────────────────
# ABSEGA Detection Platform — merged environment (AD + Web/Linux)
# Values below point at the ABSEGA (AD) lab, per the merge decision.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (app database) ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=detection_platform
DB_USER=socapp
DB_PASSWORD=

# ── Wazuh Manager API (rules, agents) ────────────────────────────────────────
WAZUH_URL=https://192.168.56.101:55000
WAZUH_USER=wazuh
WAZUH_PASSWORD=
WAZUH_VERIFY_SSL=false

# ── Wazuh Indexer / OpenSearch (Live Alerts tab, alert search) ───────────────
# Required by /api/wazuh/alerts and the Live Alerts panel.
# Same host as the manager unless your indexer runs separately.
INDEXER_URL=https://192.168.56.101:9200
INDEXER_USER=admin
INDEXER_PASSWORD=
INDEXER_VERIFY_SSL=false

# ── Attack target (DVWA / Linux attack runners) ──────────────────────────────
# Host that attack_dvwa.py and attack_linux.py execute against over SSH.
TARGET_HOST=192.168.56.101
TARGET_USER=ubuntu
TARGET_PASSWORD=

# ── Gemini (AI Detection Rule Recommendation) ────────────────────────────────
# Backend-only. The key is read by app/services/gemini_service.py and is never
# returned by an API route, rendered in the UI, written to a log or stored in
# the database. Never put it in frontend JavaScript.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Required — the workflow refuses to run rather than hardcode a model name.
# e.g. gemini-3-flash-preview  (verify with the Gemini API's model list —
#      some older model IDs list but are closed to new API keys)
GEMINI_MODEL=
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=2
GEMINI_MAX_EVIDENCE_CHARS=12000
GEMINI_RATE_LIMIT_PER_MINUTE=5

# ── AI rule deployment to the Wazuh Manager ──────────────────────────────────
# AI-drafted rules are written to one dedicated custom file; default Wazuh rule
# files are never modified. Rule IDs are allocated from this range, which is
# deliberately clear of the 100000-100999 ABSEGA attack-tagging rules.
AI_WAZUH_RULES_FILE=absega_ai_rules.xml
AI_WAZUH_RULE_ID_MIN=110000
AI_WAZUH_RULE_ID_MAX=119999
# Restart wazuh-manager after a successful deploy so the rule is loaded.
AI_WAZUH_RESTART_MANAGER=true
